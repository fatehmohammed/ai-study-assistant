# Required
ANTHROPIC_API_KEY=sk-ant-...

# Storage — set to the Railway persistent volume mount path
DATA_DIR=/data

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-app.vercel.app

# Set automatically in Docker image; only override if using a custom LibreOffice install
# SOFFICE_PATH=/usr/bin/soffice

# Optional: override the Claude model (default: claude-opus-4-7)
# CLAUDE_MODEL=claude-opus-4-7
